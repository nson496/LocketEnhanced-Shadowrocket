#!name=Locket Enhanced (Shadowrocket Edition)
#!desc=Tối ưu hóa Locket Camera chính thức: Video 60s có tiếng, Mở rộng độ dài Caption, Mở khóa Theme & Safe Mode bảo vệ tài khoản.
#!category=Locket Enhanced
#!author=Locket Enhanced Team
#!homepage=https://github.com/nson496/LocketEnhanced-Shadowrocket
#!version=0.1.1-beta
#!system=ios

[Rule]
# Chặn giao thức QUIC/UDP trên Firebase Remote Config để ép iOS chuyển về TCP/HTTP.
# Giúp Shadowrocket bắt và thực thi script can thiệp chính xác 100%.
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
# Xóa các header điều kiện ETag và Cache để chống lỗi server trả HTTP 304 Not Modified rỗng body
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del x-goog-if-none-match

[Script]
# 1. Firebase Remote Config Response - Mở khóa Video 60s có tiếng, Upload video, Caption 500 ký tự, Theme
Locket_RemoteConfig = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/nson496/LocketEnhanced-Shadowrocket/main/scripts/core/locket_remoteconfig.js, requires-body=true, max-size=-1, timeout=30

[MITM]
hostname = %APPEND% firebaseremoteconfig.googleapis.com
